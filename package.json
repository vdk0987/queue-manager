{
  "name": "queuepilot",
  "version": "0.1.0",
  "private": true,
  "description": "QueuePilot — a modern queue management system for service teams.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @queuepilot/api",
    "dev:web": "npm run dev --workspace @queuepilot/web",
    "build": "npm run build --workspace @queuepilot/api && npm run build --workspace @queuepilot/web",
    "typecheck": "npm run typecheck --workspace @queuepilot/api && npm run typecheck --workspace @queuepilot/web",
    "test": "npm run test --workspace @queuepilot/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace @queuepilot/api",
    "db:migrate": "npm run db:migrate --workspace @queuepilot/api",
    "db:deploy": "npm run db:deploy --workspace @queuepilot/api",
    "db:studio": "npm run db:studio --workspace @queuepilot/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
