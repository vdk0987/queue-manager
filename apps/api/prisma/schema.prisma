// QueuePilot data model
// QueuePilot data model for manager identity, queue operations, service flow,
// and immutable queue activity analytics.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QueueStatus {
  ACTIVE
  INACTIVE
}

enum TokenStatus {
  WAITING
  IN_SERVICE
  COMPLETED
  CANCELLED
}

model Manager {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  queues Queue[]

  @@map("managers")
}

model Queue {
  id     String      @id @default(uuid()) @db.Uuid
  name   String      @db.VarChar(100)
  status QueueStatus @default(ACTIVE)
  /** Short, stable prefix used for human-readable token numbers (e.g. Q7F2-001). */
  code   String      @unique @db.VarChar(8)
  /**
   * Monotonic counter used to allocate token numbers under a queue row lock.
   * Token numbers are permanent; this counter never moves backwards.
   */
  nextTokenNumber Int @default(1) @map("next_token_number")

  /**
   * IANA timezone used for analytics date grouping (e.g. "Europe/London").
   * Timestamps are stored in UTC and converted to this zone for day boundaries.
   */
  timezone String @default("UTC") @db.VarChar(64)

  managerId String @map("manager_id") @db.Uuid
  manager   Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  tokens     Token[]
  activities QueueActivity[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([managerId, createdAt])
  @@map("queues")
}

model Token {
  id String @id @default(uuid()) @db.Uuid

  /** Permanent, queue-scoped number. It never changes after registration. */
  tokenNumber Int @map("token_number")
  /** Mutable order within the waiting list. Null once the token leaves the line. */
  position    Int?

  participantName String  @map("participant_name") @db.VarChar(100)
  contactNumber   String? @map("contact_number") @db.VarChar(32)
  notes           String? @db.VarChar(500)

  status TokenStatus @default(WAITING)

  queueId String @map("queue_id") @db.Uuid
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  serviceStartedAt   DateTime? @map("service_started_at") @db.Timestamptz(6)
  serviceCompletedAt DateTime? @map("service_completed_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)

  @@unique([queueId, tokenNumber])
  @@unique([queueId, position])
  @@index([queueId, status, position])
  @@index([queueId, status])
  @@index([queueId, createdAt])
  @@map("tokens")
}

/**
 * Append-only history of queue mutations. Token statuses describe the present;
 * these events preserve the past (queue length over time, demand and outcomes).
 *
 * eventType is stored as text so new analytics events can be added without a
 * database migration. Waiting-count deltas live in queue-activity.service.ts.
 */
model QueueActivity {
  id String @id @default(uuid()) @db.Uuid

  queueId String @map("queue_id") @db.Uuid
  queue   Queue  @relation(fields: [queueId], references: [id], onDelete: Cascade)

  tokenId String? @map("token_id") @db.Uuid

  eventType String @map("event_type") @db.VarChar(40)
  metadata  Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([queueId, createdAt])
  @@index([queueId, eventType])
  @@index([tokenId])
  @@map("queue_activities")
}
