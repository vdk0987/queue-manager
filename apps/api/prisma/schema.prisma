// QueuePilot data model
// Phase 1: manager identity + authentication.
// Phase 2: manager-owned queues with an active/inactive lifecycle.
// Token models are introduced in Phase 3.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum QueueStatus {
  ACTIVE
  INACTIVE
}

model Manager {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  queues Queue[]

  @@map("managers")
}

model Queue {
  id     String      @id @default(uuid()) @db.Uuid
  name   String      @db.VarChar(100)
  status QueueStatus @default(ACTIVE)

  managerId String @map("manager_id") @db.Uuid
  manager   Manager @relation(fields: [managerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([managerId, createdAt])
  @@map("queues")
}
