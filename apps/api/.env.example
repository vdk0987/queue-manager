# ─────────────────────────────────────────────────────────────
# QueuePilot API — environment variables
# Copy this file to `.env` and adjust the values for your machine.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://queue:queue_dev_password@localhost:5432/queuepilot?schema=public"

# Signing key for session JWTs. Must be at least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET="dev-only-secret-change-me-in-production-0123456789"

# How long a manager stays signed in (1–30 days)
SESSION_TTL_DAYS=7

# Allowed browser origins (comma separated). Used for CORS + CSRF origin checks.
CLIENT_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Session cookie options
COOKIE_NAME=qp_session
# auto = secure when NODE_ENV=production
COOKIE_SECURE=auto
# auto = "none" in production (cross-site deploys), "lax" locally
COOKIE_SAME_SITE=auto
# COOKIE_DOMAIN=.example.com

# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=0
