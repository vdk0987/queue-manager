# Web app environment variables (all optional in local development)

# Dev proxy target used by Vite for /api requests.
VITE_DEV_API_URL=http://localhost:4000

# Only needed when the API is hosted on a different origin than the web app.
# Leave empty in local development so requests go through the Vite proxy.
# VITE_API_URL=https://your-api.example.com
